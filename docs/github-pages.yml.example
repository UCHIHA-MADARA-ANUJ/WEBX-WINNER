# Optional: GitHub Actions deployment for LATTICE (if you prefer
# "GitHub Actions" source over "Deploy from branch" in Settings → Pages).
# To use: copy to .github/workflows/deploy-pages.yml and push.
name: Deploy to GitHub Pages
on:
  push:
    branches: ["main", "arena/df15d562-webx-winner"]
  workflow_dispatch:
permissions:
  contents: read
  pages: write
  id-token: write
concurrency:
  group: "pages"
  cancel-in-progress: false
jobs:
  deploy:
    environment:
      name: github-pages
      url: ${{ steps.deployment.outputs.page_url }}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/configure-pages@v5
        with:
          enablement: true
      - uses: actions/upload-pages-artifact@v3
        with:
          path: "."
      - id: deployment
        uses: actions/deploy-pages@v4
